// Schema Prisma - AutoAtende
// Estratégia multi-tenant: schema único, isolamento por empresaId em cada tabela.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Autenticação / Administradores do painel
// ------------------------------------------------------------------
model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Um usuário administrador pode gerenciar várias empresas (modo agência/SaaS)
  empresas EmpresaUsuario[]

  @@map("usuarios")
}

// Tabela de junção N:N entre Usuario e Empresa (permite multi-empresa por admin)
model EmpresaUsuario {
  id        String  @id @default(uuid())
  usuarioId String  @map("usuario_id")
  empresaId String  @map("empresa_id")
  papel     String  @default("admin") // admin | operador (reservado p/ fases futuras)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@map("empresas_usuarios")
}

// ------------------------------------------------------------------
// Empresa (tenant principal)
// ------------------------------------------------------------------
model Empresa {
  id           String   @id @default(uuid())
  nome         String
  responsavel  String
  segmento     String
  cidade       String
  estado       String
  descricao    String?
  endereco     String?
  site         String?
  instagram    String?
  whatsapp     String?
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuarios              EmpresaUsuario[]
  servicos              Servico[]
  faqs                  Faq[]
  configuracaoAtendimento ConfiguracaoAtendimento?
  regrasAtendimento     RegraAtendimento[]
  configuracaoAgendamento ConfiguracaoAgendamento?
  automacao             Automacao?
  leads                 Lead[]
  conversas             Conversa[]
  integracaoN8n         IntegracaoN8n?
  integracaoWhatsapp    IntegracaoWhatsapp?
  integracaoIA          IntegracaoIA?

  @@map("empresas")
}

// ------------------------------------------------------------------
// Etapa 3 - Serviços
// ------------------------------------------------------------------
model Servico {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  nome            String
  descricao       String?
  preco           Decimal  @db.Decimal(10, 2)
  duracaoMinutos  Int      @map("duracao_minutos")
  disponibilidade String?
  observacoes     String?
  criadoEm        DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@index([empresaId])
  @@map("servicos")
}

// ------------------------------------------------------------------
// Etapa 4 - Perguntas frequentes
// ------------------------------------------------------------------
model Faq {
  id        String @id @default(uuid())
  empresaId String @map("empresa_id")
  pergunta  String
  resposta  String

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("faqs")
}

// ------------------------------------------------------------------
// Etapa 2 - Configuração de atendimento (1:1 com empresa)
// ------------------------------------------------------------------
model ConfiguracaoAtendimento {
  empresaId            String   @id @map("empresa_id")
  horarioInicio        String   @map("horario_inicio") // formato HH:mm
  horarioFim           String   @map("horario_fim")
  diasFuncionamento    String[] @map("dias_funcionamento") // ["seg","ter",...]
  mensagemBoasVindas   String   @map("mensagem_boas_vindas")
  mensagemForaHorario  String   @map("mensagem_fora_horario")
  nomeBot              String   @map("nome_bot")
  tom                  String   @default("profissional") // profissional|amigavel|descontraido|direto|personalizado
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_atendimento")
}

// ------------------------------------------------------------------
// Etapa 5 - Agendamento (1:1 com empresa)
// ------------------------------------------------------------------
model ConfiguracaoAgendamento {
  empresaId              String   @id @map("empresa_id")
  habilitado             Boolean  @default(false)
  diasDisponiveis        String[] @map("dias_disponiveis")
  horariosDisponiveis    String[] @map("horarios_disponiveis")
  intervaloMinutos       Int      @default(30) @map("intervalo_minutos")
  limiteSimultaneo       Int      @default(1) @map("limite_simultaneo")
  servicosAgendaveisIds  String[] @map("servicos_agendaveis_ids")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_agendamento")
}

// ------------------------------------------------------------------
// Etapa 6 - Regras de atendimento
// ------------------------------------------------------------------
model RegraAtendimento {
  id                     String   @id @default(uuid())
  empresaId              String   @map("empresa_id")
  palavrasChaveHumano    String[] @map("palavras_chave_humano")
  assuntosProibidos      String[] @map("assuntos_proibidos")
  mensagemTransferencia  String   @map("mensagem_transferencia")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("regras_atendimento")
}

// ------------------------------------------------------------------
// Etapa 7 / Motor de automação - configuração compilada (1:1 com empresa)
// ------------------------------------------------------------------
model Automacao {
  empresaId             String   @id @map("empresa_id")
  ativa                 Boolean  @default(false)
  nivelIA               String   @default("sem_ia") @map("nivel_ia") // sem_ia|basica|avancada
  configuracaoCompilada Json     @map("configuracao_compilada")
  atualizadoEm          DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("automacoes")
}

// ------------------------------------------------------------------
// Leads
// ------------------------------------------------------------------
model Lead {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  nome           String
  telefone       String
  interesse      String?
  servicoId      String?  @map("servico_id")
  origem         String   @default("simulador")
  status         String   @default("novo") // novo|em_atendimento|agendado|convertido|perdido
  ultimaMensagem String?  @map("ultima_mensagem")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  servico Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([status])
  @@map("leads")
}

// ------------------------------------------------------------------
// Conversas e mensagens (usado pelo simulador e, depois, pelo WhatsApp real)
// ------------------------------------------------------------------
model Conversa {
  id           String   @id @default(uuid())
  empresaId    String   @map("empresa_id")
  canal        String   @default("simulador") // simulador|whatsapp
  numeroCliente String? @map("numero_cliente")
  criadoEm     DateTime @default(now()) @map("criado_em")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@index([empresaId])
  @@map("conversas")
}

model Mensagem {
  id         String   @id @default(uuid())
  conversaId String   @map("conversa_id")
  remetente  String   // cliente|bot|atendente
  conteudo   String
  criadoEm   DateTime @default(now()) @map("criado_em")

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("mensagens")
}

// ------------------------------------------------------------------
// Integrações (estrutura reservada - credenciais sempre criptografadas)
// ------------------------------------------------------------------
model IntegracaoN8n {
  empresaId          String   @id @map("empresa_id")
  n8nInstanceUrl     String?  @map("n8n_instance_url")
  webhookUrl         String?  @map("webhook_url")
  apiKeyCriptografada String? @map("api_key_criptografada")
  conectado          Boolean  @default(false)
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("integracoes_n8n")
}

model IntegracaoWhatsapp {
  empresaId               String   @id @map("empresa_id")
  phoneNumberId           String?  @map("phone_number_id")
  wabaId                  String?  @map("waba_id")
  accessTokenCriptografado String? @map("access_token_criptografado")
  webhookVerifyToken      String?  @map("webhook_verify_token")
  modo                    String   @default("demo") // demo|producao
  conectado               Boolean  @default(false)
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("integracoes_whatsapp")
}

model IntegracaoIA {
  empresaId           String   @id @map("empresa_id")
  provedor            String?  // ex: anthropic (definido futuramente)
  apiKeyCriptografada String?  @map("api_key_criptografada")
  conectado           Boolean  @default(false)
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("integracoes_ia")
}
